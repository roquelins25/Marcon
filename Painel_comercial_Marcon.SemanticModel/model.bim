        "partitions": [
          {
            "name": "MEG_EXCEL_CAMPANHA",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Fonte = PowerPlatform.Dataflows(null),",
                "    Workspaces = Fonte{[Id=\"Workspaces\"]}[Data],",
                "    #\"6b3d0be9-cdbd-4454-b8dc-62bf05ebb307\" = Workspaces{[workspaceId=\"6b3d0be9-cdbd-4454-b8dc-62bf05ebb307\"]}[Data],",
                "    #\"74c7e4e3-0e00-4a9e-b0a5-c934ae13e41e\" = #\"6b3d0be9-cdbd-4454-b8dc-62bf05ebb307\"{[dataflowId=\"74c7e4e3-0e00-4a9e-b0a5-c934ae13e41e\"]}[Data],",
                "    MEG_EXCEL_CAMPANHA_ = #\"74c7e4e3-0e00-4a9e-b0a5-c934ae13e41e\"{[entity=\"MEG_EXCEL_CAMPANHA\",version=\"\"]}[Data],",
                "    #\"Colunas Renomeadas\" = Table.RenameColumns(MEG_EXCEL_CAMPANHA_,{{\"VENDEDOR\", \"REPRESENTANTE\"}}),",
                "    #\"Data Inserida\" = Table.AddColumn(#\"Colunas Renomeadas\", \"Data\", each #date([ANO], [MES], [DIA]), type date),",
                "    #\"Tipo Alterado\" = Table.TransformColumnTypes(#\"Data Inserida\",{{\"ID_PRODUTO\", Int64.Type}}),",
                "    #\"Texto Aparado\" = Table.TransformColumns(#\"Tipo Alterado\",{{\"REPRESENTANTE\", Text.Trim, type text}}),",
                "    #\"Linhas Filtradas\" = Table.SelectRows(#\"Texto Aparado\", each ([ID_VENDEDOR] <> 24))",
                "in",
                "    #\"Linhas Filtradas\""
              ],
              "type": "m"
            }
          }
        ]
      },
