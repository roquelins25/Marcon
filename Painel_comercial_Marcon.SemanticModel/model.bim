                "    #\"Tipo Alterado\" = Table.TransformColumnTypes(#\"Cabeçalhos Promovidos\",{{\"ID\", type text}, {\"SENHA\", Int64.Type}, {\"ID_VENDEDOR\", Int64.Type}, {\"REPRESENTANTE\", type text}, {\"Ativo / Inativo\", type text}}),",
                "    #\"Linhas Filtradas\" = Table.SelectRows(#\"Tipo Alterado\", each ([ID] <> null and [ID] <> \"\") and ([#\"Ativo / Inativo\"] = \"A\"))",
                "in",
                "    #\"Linhas Filtradas\""
              ],
              "type": "m"
            }
          }
        ]
