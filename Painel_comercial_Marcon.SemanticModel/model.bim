        "partitions": [
          {
            "name": "TB_CLIENTE",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Fonte = PowerPlatform.Dataflows(null),",
                "    Workspaces = Fonte{[Id=\"Workspaces\"]}[Data],",
                "    #\"6b3d0be9-cdbd-4454-b8dc-62bf05ebb307\" = Workspaces{[workspaceId=\"6b3d0be9-cdbd-4454-b8dc-62bf05ebb307\"]}[Data],",
                "    #\"74c7e4e3-0e00-4a9e-b0a5-c934ae13e41e\" = #\"6b3d0be9-cdbd-4454-b8dc-62bf05ebb307\"{[dataflowId=\"74c7e4e3-0e00-4a9e-b0a5-c934ae13e41e\"]}[Data],",
                "    TB_CLIENTE_ = #\"74c7e4e3-0e00-4a9e-b0a5-c934ae13e41e\"{[entity=\"TB_CLIENTE\",version=\"\"]}[Data],",
                "    #\"Coluna Mesclada Inserida\" = Table.AddColumn(TB_CLIENTE_, \"xCliente\", each Text.Combine({Text.From([Codigo], \"pt-BR\"), [Nome]}, \" - \"), type text)",
                "in",
                "    #\"Coluna Mesclada Inserida\""
              ],
              "type": "m"
            }
          }
        ]
      },
