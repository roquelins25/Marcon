          {
            "name": "SemanaAno",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "int64",
            "formatString": "0",
            "isDataTypeInferred": true,
            "isNameInferred": true,
            "lineageTag": "47ab9754-c719-495c-8d4e-c61849e329c5",
            "sourceColumn": "[SemanaAno]",
            "summarizeBy": "sum",
            "type": "calculatedTableColumn"
          }
        ],
        "lineageTag": "703715c0-5bb1-4c3c-9132-65078b987f35",
        "measures": [
          {
            "name": "TOTAL_DIAS",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT('CALENDARIO DAX'[Date]),",
              "    'Calendario DAX'[Mês] = MONTH(SELECTEDVALUE('Data_Atualização'[data atualizada])) &&",
              "    'Calendario DAX'[Ano] = YEAR(SELECTEDVALUE('Data_Atualização'[data atualizada]))",
              "    )"
            ],
            "formatString": "0",
            "lineageTag": "b616a6f5-8a13-4cc6-8f2b-1033d866eba2"
          },
          {
            "name": "DIAS_PERCORRIDOS",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "expression": [
              "",
              "CALCULATE(",
              "    [TOTAL_DIAS],",
              "    'CALENDARIO DAX'[Date] <= SELECTEDVALUE('Data_Atualização'[data atualizada])",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "e185ce01-6ffd-49af-801c-267a32a18aa1"
          },
          {
            "name": "Dias Faltantes",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "expression": [
              "",
              "VAR vDIAS =",
              "[TOTAL_DIAS] - [DIAS_PERCORRIDOS]",
              "RETURN",
              "\"Faltam: \" & FORMAT( vDIAS, \"\" ) & \" Dias Úteis\""
            ],
            "lineageTag": "6527bc12-1ccd-4e8c-92fa-a1f64bb10c44"
          },
          {
            "name": "Calendario Periodo select",
            "expression": [
              "",
              "VAR vMIN = MIN( 'CALENDARIO DAX'[Date] )",
              "VAR vMAX = MAX( 'CALENDARIO DAX'[Date] )",
              "",
              "RETURN",
              "vMIN & \" - \" & vMAX"
            ],
            "lineageTag": "08b9ccdc-d7d7-4f49-b192-cb9d7f013ebf"
          }
        ],
        "partitions": [
          {
            "name": "CALENDARIO DAX",
            "mode": "import",
            "source": {
              "expression": [
                "",
                "var minAno = YEAR(MIN(MEG_EXCEL_CAMPANHA[Data])) //2026",
                "var MaxAno = YEAR(MAX(MEG_EXCEL_CAMPANHA[Data])) //2035",
                "RETURN",
                "ADDCOLUMNS(",
                "    FILTER(",
                "        CALENDARAUTO(),",
                "        YEAR([Date]) >= minAno &&",
                "        YEAR([Date]) <= MaxAno),",
                "        \"Ano\", YEAR([Date]),",
                "        \"AnoNumber\", YEAR( [Date] ),",
                "        \"Mês\", MONTH([Date]),",
                "        \"Nome do Mês\", FORMAT([Date],\"mmmm\",\"PT-BR\"),",
                "        \"Mês Abrev\",UPPER(LEFT(FORMAT([Date], \"mmm\"), 1)) & LOWER(RIGHT(FORMAT([Date], \"mmm\"), 2)),",
                "        \"trimestre\", CONCATENATE(QUARTER([Date]),\"-Trimestre\"),",
                "        \"semestre\", SWITCH(",
                "                        TRUE(),",
                "                        MONTH([Date]) IN{1,2,3,4,5,6}, \"1-Sem\",",
                "                        \"2-Sem\"),",
                "        \"Dia\",DAY([Date]),",
                "        \"Dia/Mes\", FORMAT([Date],\"dd-mmm\") ,",
                "        \"DiasSemana\",FORMAT( [Date], \"ddd\" ),",
                "        \"Mes Atual\", IF( YEAR( [Date] ) = YEAR( TODAY() ) && MONTH( [Date] ) = MONTH( TODAY() ), \"S\", \"N\" ),",
                "        \"Ano-Mes\", UPPER(LEFT(FORMAT([Date], \"mmm\"), 1)) & LOWER(RIGHT(FORMAT([Date], \"mmm\"), 2)) & \"-\" & YEAR( [Date] ),",
                "        \"OrderBy\", (YEAR( [Date] )*100) + MONTH( [Date] ),",
                "        \"SemanaAno\", WEEKNUM( [Date] )",
                "    )"
              ],
              "type": "calculated"
            }
          }
        ]
      },
