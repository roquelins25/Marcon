          {
            "name": "xAcesso",
            "expression": [
              "",
              "SWITCH(",
              "    TRUE(),",
              "    HASONEFILTER( TB_Acess[ID] ) && ValorSenha[Valor ValorSenha] = MAX( TB_Acess[SENHA] ), \"Home\",",
              "    HASONEFILTER( TB_AcssREP[Representante] ) && ValorSenha[Valor ValorSenha] = MAX( TB_AcssREP[Senha] ), \"Home\",",
              "    \"Senha Errada\" )"
            ],
            "lineageTag": "bb5cdeb8-e8d2-4e2a-abf7-9ee6f32f106c"
          }
        ],
        "partitions": [
          {
            "name": "ValorSenha",
            "mode": "import",
            "source": {
              "expression": "GENERATESERIES(1, 9999, 1)",
              "type": "calculated"
            }
          }
        ]
      },
