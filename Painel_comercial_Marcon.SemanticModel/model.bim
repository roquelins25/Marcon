            ],
            "lineageTag": "da3d32bd-4cce-493d-86d5-01b0fcd28bc3"
          },
          {
            "name": "Total Dev A.A",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "displayFolder": "*Outros",
            "expression": [
              "",
              "CALCULATE(",
              "    [Total devolucao],",
              "    SAMEPERIODLASTYEAR( 'Calendario DAX'[Date] )",
              ")"
            ],
            "lineageTag": "e8b2b256-576a-4798-97ec-fd811978ea0f"
          },
          {
            "name": "YTD Dev",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "displayFolder": "*Outros",
            "expression": [
              "",
              "TOTALYTD(",
              "    [Total devolucao],",
              "    'Calendario DAX'[Date] )",
              "    "
            ],
            "lineageTag": "5a507f49-d63f-4572-9aca-7ee307993079"
          },
          {
            "name": "YTD dev A.A",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "displayFolder": "*Outros",
            "expression": [
              "",
              "TOTALYTD(",
              "    [Total Dev A.A],",
              "    'Calendario DAX'[Date] )",
              "    "
            ],
            "lineageTag": "6daf714d-dba0-4b2b-931b-8589fa4eabd5"
          },
          {
            "name": "_Devolucao vs faturamento",
            "displayFolder": "*Outros",
            "expression": [
              "",
              "DIVIDE(",
              "    [Total devolucao], [TOTAL_FATURADO] , 0)"
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "c8f4764c-a5e5-4115-95ea-d0fdf7d85c57"
          },
          {
            "name": "_Devolucao vs faturamento ytd",
            "displayFolder": "*Outros",
            "expression": [
              "",
              "DIVIDE(",
              "    [YTD Dev], [YTD FATURADO], 0 )"
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "1a2ec5cf-04e3-4a9c-abd5-9047dc041d0c"
          },
          {
            "name": "Faturado Mes Anterior",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"pt-BR\"}"
              }
            ],
            "displayFolder": "COMERCIAL",
            "expression": [
              "",
              "CALCULATE(",
              "    [TOTAL_FATURADO],",
              "    DATEADD( 'Calendario DAX'[Date] , -1 , MONTH )",
              ")"
            ],
            "formatString": "\"R$\"\\ #,0.00;-\"R$\"\\ #,0.00;\"R$\"\\ #,0.00",
            "lineageTag": "64a7f22f-993f-436a-9b30-fe93e69229a5"
          },
          {
            "name": "% M.A",
            "displayFolder": "COMERCIAL",
            "expression": [
              "",
              "// Percentual vs mes Anterior",
              "DIVIDE( [TOTAL_FATURADO] - [Faturado Mes Anterior], [Faturado Mes Anterior] , 0 )"
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "b544a884-6628-4208-94e1-493e51874db5"
          },
          {
            "name": "Diff Fat vs meta",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"pt-BR\"}"
              }
            ],
            "displayFolder": "COMERCIAL",
            "expression": [
              "",
              "[TOTAL_FATURADO] - [TOTAL_METAS]"
            ],
            "formatString": "\"R$\"\\ #,0.00;-\"R$\"\\ #,0.00;\"R$\"\\ #,0.00",
            "lineageTag": "906226e2-1203-4986-bade-b7ebc5610c92"
          },
          {
            "name": "% tendencia vs Ano anterior",
            "displayFolder": "COMERCIAL",
            "expression": [
              "",
              "DIVIDE( [TENDENCIA_FATURAMENTO] - [TOTAL_FAT_A.A], [TOTAL_FAT_A.A] , 0 )"
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "e571e037-0a5c-4c57-890d-d4c9910a897a"
          },
          {
            "name": "% Positivado vs Total de clientes",
            "displayFolder": "COBERTURA",
            "expression": [
              "",
              "DIVIDE( [Positivados], [Total cliente] , 0 )"
            ],
            "formatStringDefinition": {
              "expression": "\"0.00%;-0.00%;0.00%\""
            },
            "lineageTag": "db685a13-5167-4734-8a91-66528d3b9812"
          },
          {
            "name": "Cor Texto Calendario",
            "displayFolder": "*Outros",
            "expression": [
              "",
              "VAR _media = ",
              "AVERAGEX(",
              "    ALLSELECTED( 'CALENDARIO DAX' ),",
              "    [TOTAL_FATURADO] )",
              "VAR _MediaAjustada = _media * 1.2",
              "RETURN",
              "SWITCH(",
              "    TRUE(),",
              "    [TOTAL_FATURADO] < 0 , \"#FF0000\",",
              "    [TOTAL_FATURADO] < _MediaAjustada, \"#000000\",",
              "    [TOTAL_FATURADO] > _MediaAjustada, \"#FFFFFF\",",
              "    \"#000000\" )"
            ],
            "lineageTag": "8907105f-dbd9-45eb-9ab0-68669463d501"
          },
          {
            "name": "Sem Positivacao",
            "displayFolder": "COBERTURA",
            "expression": [
              "",
              "CALCULATE(",
              "    [Total cliente],",
              "    FILTER(",
              "        TB_CLIENTE ,",
              "        ISBLANK( [TOTAL_FATURADO] ) ",
              "        )",
              ")"
            ],
            "formatString": "#,0",
            "lineageTag": "ddcb88e3-ebe0-4da6-932e-0aee99458c7e"
          },
          {
            "name": "* Positivados Text",
            "displayFolder": "COBERTURA",
            "expression": [
              "",
              "\"( 🟢 \" & FORMAT( [% Positivado vs Total de clientes], \"0.00%;-0.00%;0.00%\") & \" da Carteira )\""
            ],
            "lineageTag": "4d283032-344b-441f-96f3-012871d8f885"
          },
          {
            "name": "* S Positivados Text",
            "displayFolder": "COBERTURA",
            "expression": [
              "",
              "VAR vTOTAL = DIVIDE( [Sem Positivacao], [Total cliente] , 0 )",
              "RETURN",
              "\"( 🔴 \" & FORMAT( vTOTAL, \"0.00%;-0.00%;0.00%\") & \" da Carteira )\""
            ],
            "lineageTag": "6aaca9cd-6bd4-4ff5-91e4-650d6adc2d61"
          },
          {
            "name": "Ultima Venda",
            "displayFolder": "COBERTURA",
            "expression": [
              "",
              "CALCULATE(",
              "    LASTDATE( MEG_EXCEL_CAMPANHA[Data] ),",
              "    ALL( 'CALENDARIO DAX' )",
              ")"
            ],
            "formatString": "Short Date",
            "lineageTag": "56c253db-22bc-47de-a4dd-3364fce4c41f"
          },
          {
            "name": "Dias Sem Compra",
            "displayFolder": "COBERTURA",
            "expression": [
              "",
              "DATEDIFF( [Ultima Venda] , TODAY() , DAY )"
            ],
            "formatString": "0",
            "lineageTag": "8b061ad4-a4f2-40c5-b84d-c0dc31d22afe"
          },
          {
            "name": "Total Faturado ao longo do tempo",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "displayFolder": "*Outros",
            "expression": [
              "",
              "CALCULATE(",
              "    SUM(MEG_EXCEL_CAMPANHA[TOTAL_NOTA]),",
              "    ALL( 'CALENDARIO DAX' )",
              ")"
            ],
            "lineageTag": "28c946ca-2fd1-428d-bd2a-ad82755fa8e8"
          },
          {
            "name": "Media Mensal ao longo do tempo",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "displayFolder": "*Outros",
            "expression": [
              "",
              "VAR Total =",
              "    CALCULATE(",
              "        SUM(MEG_EXCEL_CAMPANHA[TOTAL_NOTA]),",
              "        ALL('CALENDARIO DAX')",
              "    )",
              "VAR Meses =",
              "    CALCULATE(",
              "        DISTINCTCOUNT('CALENDARIO DAX'[Ano-Mes]),",
              "        ALL('CALENDARIO DAX')",
              "    )",
              "RETURN",
              "    DIVIDE(Total, Meses)"
            ],
            "lineageTag": "1fe4f781-2dbb-4d0e-8524-b26977cef5fe"
          },
          {
            "name": "AUXDias",
            "displayFolder": "COBERTURA",
            "expression": [
              "",
              "SWITCH(",
              "    TRUE(),",
              "    [Dias Sem Compra] <= 30, 2,",
              "    [Dias Sem Compra] > 30 && [Dias Sem Compra] <= 60, 3,",
              "    [Dias Sem Compra] > 60 && [Dias Sem Compra] <= 90, 4,",
              "    5 )"
            ],
            "formatString": "0",
            "lineageTag": "9e8370f0-bdc5-49d4-8b6f-1a350ac9bf07"
          },
          {
            "name": "AUXFILTRO",
            "displayFolder": "COBERTURA",
            "expression": [
              "",
              "VAR vSELECT = VALUE( SELECTEDVALUE( yTBAux[Ordem] ) )",
              "VAR vMEDIDA = [AUXDias]",
              "VAR vRESULT =",
              "SWITCH(",
              "    TRUE(),",
              "    vSELECT = 2 && vMEDIDA = 2, 1,",
              "    vSELECT = 3 && vMEDIDA = 3, 1,",
              "    vSELECT = 4 && vMEDIDA = 4, 1,",
              "    vSELECT = 5 && vMEDIDA = 5, 1,",
              "    vSELECT = 1 , 1,",
              "    0 )",
              "RETURN",
              "vRESULT"
            ],
            "formatString": "0",
            "lineageTag": "564b7157-6d9e-48db-b6b3-d8baaed00dcd"
          }
        ],
        "partitions": [
          {
            "name": "_Medidas",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Fonte = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"i44FAA==\", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#\"Coluna 1\" = _t]),",
                "    #\"Colunas Removidas\" = Table.RemoveColumns(Fonte,{\"Coluna 1\"})",
                "in",
                "    #\"Colunas Removidas\""
              ],
              "type": "m"
            }
          }
        ]
      },
