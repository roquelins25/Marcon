        "partitions": [
          {
            "name": "META",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Fonte = Excel.Workbook(Web.Contents(\"https://docs.google.com/spreadsheets/d/e/2PACX-1vQW99jwSxn50ubU4xGEi_HasxwPSfW9q4p6km7iMzQ3nnhiXj-UYZpwDfz3vKu4bA/pub?output=xlsx\"), null, true),",
                "    #\"Linhas Filtradas\" = Table.SelectRows(Fonte, each ([Name] = \"Planilha1\")),",
                "    #\"Outras Colunas Removidas\" = Table.SelectColumns(#\"Linhas Filtradas\",{\"Data\"}),",
                "    #\"Data Expandido\" = Table.ExpandTableColumn(#\"Outras Colunas Removidas\", \"Data\", {\"Column1\", \"Column2\", \"Column3\", \"Column4\", \"Column5\", \"Column6\", \"Column7\"}, {\"Data.Column1\", \"Data.Column2\", \"Data.Column3\", \"Data.Column4\", \"Data.Column5\", \"Data.Column6\", \"Data.Column7\"}),",
                "    #\"Cabeçalhos Promovidos\" = Table.PromoteHeaders(#\"Data Expandido\", [PromoteAllScalars=true]),",
                "    #\"Linhas Filtradas1\" = Table.SelectRows(#\"Cabeçalhos Promovidos\", each ([ID] <> null and [ID] <> \"ID\")),",
                "    #\"Tipo Alterado\" = Table.TransformColumnTypes(#\"Linhas Filtradas1\",{{\"ID\", Int64.Type}, {\"Valor\", type number}, {\"Mês\", Int64.Type}, {\"Ano\", Int64.Type}, {\"Data\", type date}, {\"Positivação\", Int64.Type}, {\"Representante\", type text}}),",
                "    #\"Texto Aparado\" = Table.TransformColumns(#\"Tipo Alterado\",{{\"Representante\", Text.Trim, type text}})",
                "in",
                "    #\"Texto Aparado\""
              ],
              "type": "m"
            }
          }
        ]
      },
      {
        "name": "_Medidas",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "lineageTag": "1fdea580-9f8e-4688-95ac-71438b7e33ec",
        "measures": [
          {
            "name": "TOTAL_FATURADO",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"pt-BR\"}"
              }
            ],
            "displayFolder": "COMERCIAL",
            "expression": [
              "",
              "SUMX(",
              "    MEG_EXCEL_CAMPANHA,",
              "    MEG_EXCEL_CAMPANHA[TOTAL_NOTA] - MEG_EXCEL_CAMPANHA[TOTAL_NOTA_DEVOLUCAO])"
            ],
            "formatString": "\"R$\"\\ #,0;-\"R$\"\\ #,0;\"R$\"\\ #,0",
            "lineageTag": "c5b700b3-286f-4e67-b6d2-a1d23cedb173"
          },
          {
            "name": "TOTAL_VOLUME",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDecimal\":true}"
              }
            ],
            "displayFolder": "COMERCIAL",
            "expression": [
              "",
              "SUMX(",
              "    MEG_EXCEL_CAMPANHA,",
              "    MEG_EXCEL_CAMPANHA[TOTAL_QTDE] - MEG_EXCEL_CAMPANHA[TOTAL_QTDE_DEVOLUCAO])"
            ],
            "formatString": "#,0",
            "lineageTag": "751f0d3a-e7f3-4418-9f58-8264a4f226f8"
          },
          {
            "name": "TOTAL_METAS",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"pt-BR\"}"
              }
            ],
            "displayFolder": "COMERCIAL",
            "expression": [
              "",
              "IF(",
              "    ISINSCOPE( TB_CLIENTE[nome] ) , BLANK() , ",
              "    IF(",
              "        HASONEFILTER( MEG_EXCEL_CAMPANHA[FORNECEDOR] ), BLANK() , SUM(META[Valor]) )",
              ")"
            ],
            "formatString": "\"R$\"\\ #,0;-\"R$\"\\ #,0;\"R$\"\\ #,0",
            "lineageTag": "74dc5128-1c32-40b8-8611-3856f46c2b55"
          },
          {
            "name": "TOTAL_FAT_A.A",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"pt-BR\"}"
              }
            ],
            "displayFolder": "COMERCIAL",
            "expression": [
              "",
              "CALCULATE(",
              "    [TOTAL_FATURADO],",
              "    SAMEPERIODLASTYEAR('Calendario DAX'[Date])",
              ")"
            ],
            "formatString": "\"R$\"\\ #,0;-\"R$\"\\ #,0;\"R$\"\\ #,0",
            "lineageTag": "0954bf8d-59ed-44fb-ba1a-cef3e52fcbb1"
          },
          {
            "name": "%META",
            "displayFolder": "COMERCIAL",
            "expression": [
              "",
              "IF(",
              "    ISBLANK([TOTAL_FATURADO]),BLANK(),",
              "    DIVIDE([TOTAL_FATURADO],[TOTAL_METAS])",
              ")"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "412427c4-b5f1-4d3e-be34-895eb00e2418"
          },
          {
            "name": "META_CARTAO",
            "displayFolder": "*Outros",
            "expression": [
              "",
              "IF(",
              "    ISINSCOPE( TB_CLIENTE[Nome] ) , BLANK() , ",
              "DIVIDE([TOTAL_FATURADO] - [TOTAL_METAS] ,[TOTAL_METAS],0)",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "ab9ba282-6747-4ffa-bb99-34015628c1f9"
          },
          {
            "name": "TENDENCIA_FATURAMENTO",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"pt-BR\"}"
              }
            ],
            "displayFolder": "COMERCIAL",
            "expression": [
              "",
              "var vTEND = ",
              "DIVIDE([TOTAL_FATURADO],[DIAS_PERCORRIDOS])",
              "RETURN",
              "vTEND * [TOTAL_DIAS]"
            ],
            "formatString": "\"R$\"\\ #,0;-\"R$\"\\ #,0;\"R$\"\\ #,0",
            "lineageTag": "29857834-e6aa-4b52-956e-644a8f0342a4"
          },
          {
            "name": "%TEND",
            "displayFolder": "COMERCIAL",
            "expression": [
              "",
              "IF(",
              "    ISBLANK([TOTAL_FATURADO]),BLANK(),",
              "    DIVIDE([TENDENCIA_FATURAMENTO] -  [TOTAL_METAS] ,[TOTAL_METAS],0)",
              ")"
            ],
            "formatString": "0%;-0%;0%",
            "lineageTag": "dcdb5f9c-6b10-4259-b6cb-a7d8b5534bae"
          },
          {
            "name": "%A.A",
            "displayFolder": "COMERCIAL",
            "expression": [
              "",
              "IF(",
              "    ISBLANK([TOTAL_FATURADO]),BLANK(),",
              "    DIVIDE([TOTAL_FATURADO] - [TOTAL_FAT_A.A],[TOTAL_FAT_A.A])",
              ")"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "42cf3b4b-b340-483d-8818-68494194aff8"
          },
          {
            "name": "Total cliente",
            "displayFolder": "COBERTURA",
            "expression": [
              "",
              "COUNTROWS( ",
              "    CALCULATETABLE(",
              "        TB_CLIENTE,",
              "        USERELATIONSHIP( D_REP[ID_VENDEDOR], TB_CLIENTE[Vendedor] )",
              " ))"
            ],
            "formatString": "#,0",
            "lineageTag": "2650ba0f-d09a-4669-86a2-7840480f0a7e"
          },
          {
            "name": "Positivados",
            "displayFolder": "COBERTURA",
            "expression": [
              "",
              "CALCULATE(",
              "    [Total cliente],",
              "    FILTER(",
              "        TB_CLIENTE ,",
              "        [TOTAL_FATURADO] > 0)",
              ")"
            ],
            "formatString": "#,0",
            "lineageTag": "8b1f25b3-f4fd-4d70-a57a-8383a233ea3a"
          },
          {
            "name": "Meta_Positivacao",
            "displayFolder": "*Outros",
            "expression": [
              "",
              "SUM(META[Positivação])"
            ],
            "formatString": "0",
            "lineageTag": "daf33b04-5d6f-491e-8b22-56abd5a6a346"
          },
          {
            "name": "%Positivacao",
            "displayFolder": "COBERTURA",
            "expression": [
              "",
              "DIVIDE(",
              "    [Positivados],[Meta_Positivacao],BLANK())"
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "db2a685c-30ec-4b44-a69a-9684258e99b6"
          },
          {
            "name": "Cobertura A.A",
            "displayFolder": "COBERTURA",
            "expression": [
              "",
              "CALCULATE(",
              "    [Positivados],",
              "    SAMEPERIODLASTYEAR('Calendario DAX'[Date])",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "6cba6a5d-57d1-4f58-ad44-c9be602da00b"
          },
          {
            "name": "Atendidos",
            "displayFolder": "SEM COMPRAS",
            "expression": [
              "",
              "CALCULATE(",
              "COUNTROWS(",
              "    TB_CLIENTE),",
              "    FILTER(",
              "        TB_CLIENTE,",
              "        [TOTAL_FATURADO] > 0))"
            ],
            "formatString": "0",
            "lineageTag": "feaa4bd3-a0d4-4298-a8c4-9bfefcfbe509"
          },
          {
            "name": "s/atendimento",
            "displayFolder": "SEM COMPRAS",
            "expression": [
              "",
              "[Total cliente] - [Atendidos]"
            ],
            "formatString": "0",
            "lineageTag": "9432455d-976e-4c7b-87f0-0e20b997cd85"
          },
          {
            "name": "%s/atendimento",
            "displayFolder": "SEM COMPRAS",
            "expression": [
              "",
              "DIVIDE(",
              "    [s/atendimento],",
              "CALCULATE(",
              "    [Total cliente],",
              "    ALL('CLIENTES/SEM COMRA'[Filtros])",
              "),1)"
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "7cc2745a-7f20-4567-976a-c37a8b320d27"
          },
          {
            "name": "DIAS SEM COMPRAS",
            "displayFolder": "SEM COMPRAS",
            "expression": [
              "",
              "CALCULATE(",
              "DATEDIFF(",
              "    [DATA MAXIMA] ,",
              "SELECTEDVALUE('Data_Atualização'[data atualizada]),DAY)",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "61da66aa-a65a-42b4-bd64-349d44d2a13e"
          },
          {
            "name": "DATA MAXIMA",
            "displayFolder": "SEM COMPRAS",
            "expression": [
              "",
              "CALCULATE(",
              "LASTDATE(MEG_EXCEL_CAMPANHA[Data]),",
              "MEG_EXCEL_CAMPANHA[TOTAL_NOTA_DEVOLUCAO] = 0)"
            ],
            "formatString": "Short Date",
            "lineageTag": "ed83dfd3-f32e-41db-b8f2-7d33325482e2"
          },
          {
            "name": "YTD FATURADO",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "displayFolder": "COMERCIAL",
            "expression": [
              "",
              "TOTALYTD(",
              "    [TOTAL_FATURADO],",
              "    'Calendario DAX'[Date])"
            ],
            "lineageTag": "7fe1e86d-aca7-4052-a22c-19a9ae84393c"
          },
          {
            "name": "Volume_Ultimo pedido",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDecimal\":true}"
              }
            ],
            "displayFolder": "SEM COMPRAS",
            "expression": [
              "",
              "SUMX (",
              "    FILTER (",
              "        MEG_EXCEL_CAMPANHA,",
              "        MEG_EXCEL_CAMPANHA[COD_CLIENTE] = MAXX ( MEG_EXCEL_CAMPANHA, MEG_EXCEL_CAMPANHA[COD_CLIENTE] )",
              "            && MEG_EXCEL_CAMPANHA[Data] = MAXX ( FILTER ( MEG_EXCEL_CAMPANHA, MEG_EXCEL_CAMPANHA[COD_CLIENTE] = MAXX ( MEG_EXCEL_CAMPANHA, MEG_EXCEL_CAMPANHA[COD_CLIENTE] ) && MEG_EXCEL_CAMPANHA[TOTAL_QTDE_DEVOLUCAO] = 0  ), MEG_EXCEL_CAMPANHA[Data] )",
              "    ),",
              "    MEG_EXCEL_CAMPANHA[TOTAL_QTDE]",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "eebd422b-1cdb-4156-8e25-91a83cf1d827"
          },
          {
            "name": "Valor_Ultimo pedido",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "displayFolder": "SEM COMPRAS",
            "expression": [
              "",
              "SUMX (",
              "    FILTER (",
              "        MEG_EXCEL_CAMPANHA,",
              "        MEG_EXCEL_CAMPANHA[COD_CLIENTE] = MAXX ( MEG_EXCEL_CAMPANHA, MEG_EXCEL_CAMPANHA[COD_CLIENTE] )",
              "            && MEG_EXCEL_CAMPANHA[Data] = MAXX ( FILTER ( MEG_EXCEL_CAMPANHA, MEG_EXCEL_CAMPANHA[COD_CLIENTE] = MAXX ( MEG_EXCEL_CAMPANHA, MEG_EXCEL_CAMPANHA[COD_CLIENTE] ) && MEG_EXCEL_CAMPANHA[TOTAL_NOTA_DEVOLUCAO] = 0 ), MEG_EXCEL_CAMPANHA[Data] )",
              "    ),",
              "    MEG_EXCEL_CAMPANHA[TOTAL_NOTA]",
              ")"
            ],
            "lineageTag": "26880555-19ca-4d92-8312-df7a653a00f0"
          },
          {
            "name": "Filtro2",
            "displayFolder": "SEM COMPRAS",
            "expression": [
              "",
              "var Vtotalcli =",
              " COUNTROWS(VALUES(TB_CLIENTE[Codigo]))",
              "",
              "RETURN",
              "Vtotalcli"
            ],
            "formatString": "0",
            "lineageTag": "08a27156-b89d-466b-b529-3d6a4bcecff8"
          },
          {
            "name": "Comprou",
            "displayFolder": "SEM COMPRAS",
            "expression": [
              "",
              "DISTINCTCOUNT(MEG_EXCEL_CAMPANHA[COD_CLIENTE])"
            ],
            "formatString": "0",
            "lineageTag": "e9834401-75ba-413b-88c3-1a78d3d8ec3a"
          },
          {
            "name": "DataMaximaCompra",
            "displayFolder": "SEM COMPRAS",
            "expression": [
              "",
              "CALCULATE(",
              "    MAX(MEG_EXCEL_CAMPANHA[Data]),",
              "    FILTER(",
              "        ALL('Calendario DAX'),",
              "        'Calendario DAX'[Date] < MIN('Calendario DAX'[Date])",
              "    )",
              ")"
            ],
            "formatString": "General Date",
            "lineageTag": "a9125a0c-29bb-4ebc-b526-f99e449fece2"
          },
          {
            "name": "Total devolucao",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "displayFolder": "*Outros",
            "expression": [
              "",
              "SUM( MEG_EXCEL_CAMPANHA[TOTAL_NOTA_DEVOLUCAO] )"
            ],
            "lineageTag": "06c73203-237d-4541-a03b-7d798cebdb1d"
          },
          {
            "name": "Total devolucao volume",
            "annotations": [
              {
