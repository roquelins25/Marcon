          },
          {
            "name": "Mes_indice",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "int64",
            "expression": [
              "",
              "IF( ",
              "    'Calendario AUX'[Cod. Periodo] = 2 , 13, ",
              "        MONTH( 'Calendario AUX'[Data] )",
              ")"
            ],
            "formatString": "0",
            "isDataTypeInferred": true,
            "lineageTag": "302231ab-152c-4f08-af02-7943d1070499",
            "summarizeBy": "sum",
            "type": "calculated"
          },
          {
            "name": "Ano-Mes",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "isDataTypeInferred": true,
            "isNameInferred": true,
            "lineageTag": "66baf564-e50e-4bd4-b69c-74c12d4a080d",
            "sourceColumn": "CALENDARIO DAX[Ano-Mes]",
            "summarizeBy": "none",
            "type": "calculatedTableColumn"
          }
        ],
        "lineageTag": "9e25e090-9925-4dd5-9348-42ef276be5d9",
        "partitions": [
          {
            "name": "Calendario AUX",
            "mode": "import",
            "source": {
              "expression": [
                "",
                "var vDIASEMANA = ",
                "ADDCOLUMNS(",
                "    VALUES( 'CALENDARIO DAX'[Ano-Mes] ),",
                "    \"Periodo\", \"Mes\",",
                "    \"Cod. Periodo\", 1,",
                "    \"Data\",STARTOFMONTH('CALENDARIO DAX'[Date])",
                ")",
                "var vMEDIA = ",
                "ADDCOLUMNS(",
                "        VALUES( 'CALENDARIO DAX'[Ano] ),",
                "    \"Periodo\",\"Total\",",
                "    \"Cod. Periodo\", 2,",
                "    \"Data\",STARTOFMONTH('CALENDARIO DAX'[Date]) + 9999",
                ")",
                "",
                "RETURN",
                "UNION( vDIASEMANA,vMEDIA )"
              ],
              "type": "calculated"
            }
          }
        ]
      },
